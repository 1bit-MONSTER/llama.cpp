    %expert_count = check.literal value(512) : index
    %input = check.generate.fill value(0) : tensor<20971520xi8>
    %expert_table = check.generate.fill value(0) : tensor<4196352xi8>
    %partition_table = check.generate.fill value(0) : tensor<4612xi8>
    %gate_weight = check.generate.fill value(0) : tensor<325140480xi8>
    %up_weight = check.generate.fill value(0) : tensor<325140480xi8>
    %output = check.generate.fill value(0) : tensor<53084160xi8>
    check.generate<@flashnext_routed_tables>(%token_count, %route_count, %expert_count, %partition_table, %expert_table) : (index, index, index, tensor<4612xi8>, tensor<4196352xi8>) -> ()
    // element-wise known-answer test (engine #572): the shipped kernel is the target, the IQ3_XXS table
    // variant the oracle, over identical buffers; the outputs must agree bitwise.
    check.compare<@ggml_mul_mat_id_swiglu_f32_f32_wmma, @ggml_mul_mat_id_swiglu_f32_f32_wmma_iq3s_table>[%token_count](%token_count, %input, %expert_table, %partition_table, %gate_weight, %up_weight, %output) : (index, tensor<20971520xi8>, tensor<4196352xi8>, tensor<4612xi8>, tensor<325140480xi8>, tensor<325140480xi8>, tensor<53084160xi8>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<53084160xi8>
    }
  }
  check.return
}

