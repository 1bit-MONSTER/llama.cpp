          %row_byte_base = index.scale %key_value_channel, %q4_row_bytes : index, offset -> offset
          %sum = func.call @qwen3_moe_q4k_q8_1_x4_paired_row_lane(%hidden_size, %key_weight_noalias, %row_byte_base, %q8_noalias, %q8_row_byte_base, %lane) : (index, buffer, offset, buffer, offset, index) -> (f32)
          scf.yield %sum : f32
        } else {
