  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %channel_base = index.mul %channel_tile, %c8 : index
  %global_channel = index.add %channel_base, %subgroup : index
  %key_value_end = index.add %query_size, %key_value_size : index
