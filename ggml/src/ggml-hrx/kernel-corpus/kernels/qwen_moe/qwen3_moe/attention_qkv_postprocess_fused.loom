  %value_weight = check.generate.fill value(-86) : tensor<860160xi8>
  %positions = check.generate.fill value(7) : tensor<1xi32>
  %key_cache_indices = check.generate.fill value(1) : tensor<1xi64>
  %value_cache_indices = check.generate.fill value(2) : tensor<1xi64>
  %query_norm_weight = check.generate.iota offset(0.5) step(0.00390625) : tensor<128xf32>
  %key_norm_weight = check.generate.iota offset(0.75) step(0.001953125) : tensor<128xf32>
