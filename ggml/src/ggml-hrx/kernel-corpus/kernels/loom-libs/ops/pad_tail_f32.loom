//
// engine#3577: PAD whose output is the source's elements, in order, followed by zeros - an f32 PAD that grows only the
// outermost axis it changes, at its end (every axis above it 1, no left padding). The no-KV-cache attention path of an
// encoder (llama-graph.cpp, build_attn without a cache) pads K and V that way along the token axis, and V there is a
// strided view of the fused QKV output, so the source is read through its own strides (as copy_strided_source_f32
// does). One pass: out[i] = i < source_count ? source[strided(i)] : 0, the source index clamped and bounded by the
// source span.

amdgpu.target<gfx11-generic> @ggml_pad_tail_f32_gfx11_wave64 {subgroup_size = 64}

config.decl @ggml.pad_tail_f32.ne0 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad_tail_f32.ne1 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad_tail_f32.ne2 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad_tail_f32.stride0 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad_tail_f32.stride1 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad_tail_f32.stride2 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad_tail_f32.stride3 : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@ggml_pad_tail_f32_gfx11_wave64) export("ggml_pad_tail_f32") @ggml_pad_tail_f32(%element_count: index, %source_count: index, %source_span: index) {
  %one = index.constant 1 : index
  %twofiftysix = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroup_count = index.div %rounded, %twofiftysix : index
  kernel.launch.config workgroups(%workgroup_count, %one, %one) workgroup_size(%twofiftysix, %one, %one) : index
} launch(%element_count: index, %source_count: index, %source_span: index, %source: buffer, %output: buffer) {
  %count = index.assume %element_count [range(%element_count, 1, 1073741824)] : index
  %have = index.assume %source_count [range(%source_count, 1, 1073741824)] : index
  %span = index.assume %source_span [range(%source_span, 1, 1073741824)] : index
  %n0 = config.get @ggml.pad_tail_f32.ne0 : index
  %n1 = config.get @ggml.pad_tail_f32.ne1 : index
  %n2 = config.get @ggml.pad_tail_f32.ne2 : index
  %s0 = config.get @ggml.pad_tail_f32.stride0 : index
  %s1 = config.get @ggml.pad_tail_f32.stride1 : index
  %s2 = config.get @ggml.pad_tail_f32.stride2 : index
  %s3 = config.get @ggml.pad_tail_f32.stride3 : index
  %workgroup = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %twofiftysix = index.constant 256 : index
  %c0 = index.constant 0 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %base = index.mul %workgroup, %twofiftysix : index
  %linear0 = index.add %base, %workitem : index
  %linear = index.assume %linear0 [range(%linear0, 0, 1073742079)] : index
  %in_bounds = index.cmp ult, %linear, %count : index
  %in_source = index.cmp ult, %linear, %have : index
  %read_at = scf.select %in_source, %linear, %c0 : index
  %zero_offset = index.constant 0 : offset
  %source_noalias, %output_noalias = buffer.assume.noalias %source, %output : buffer, buffer
  %output_view = buffer.view %output_noalias[%zero_offset] : buffer -> view<[%count]xf32>
  scf.if %in_bounds {
    %coord0 = index.rem %read_at, %n0 : index
    %remaining0 = index.div %read_at, %n0 : index
    %coord1 = index.rem %remaining0, %n1 : index
    %remaining1 = index.div %remaining0, %n1 : index
    %coord2 = index.rem %remaining1, %n2 : index
    %coord3 = index.div %remaining1, %n2 : index
    %offset0 = index.mul %coord0, %s0 : index
    %offset1 = index.mul %coord1, %s1 : index
    %offset2 = index.mul %coord2, %s2 : index
    %offset3 = index.mul %coord3, %s3 : index
    %offset01 = index.add %offset0, %offset1 : index
    %offset23 = index.add %offset2, %offset3 : index
    %source_index0 = index.add %offset01, %offset23 : index
    %source_index, %view_span = index.assume %source_index0, %span [lt(%source_index0, %span)] : index, index
    %source_view = buffer.view %source_noalias[%zero_offset] : buffer -> view<[%view_span]xf32>
    %loaded = view.load %source_view[%source_index] : view<[%view_span]xf32> -> f32
    %value = scf.select %in_source, %loaded, %zero_f32 : f32
    view.store %value, %output_view[%linear] : f32, view<[%count]xf32>
  }
  kernel.return
}
