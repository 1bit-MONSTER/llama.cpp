} launch(%ne0: index, %ne1: index, %ne2: index, %ne3: index, %a0: index, %a1: index, %a2: index, %a3: index, %b0: index, %b1: index, %b2: index, %b3: index, %a_extent: index, %b_extent: index, %op: index, %lhs: buffer, %rhs: buffer, %output: buffer) {
  %n0 = index.assume %ne0 [range(%ne0, 1, 16777216)] : index
  %n1 = index.assume %ne1 [range(%ne1, 1, 16777216)] : index
