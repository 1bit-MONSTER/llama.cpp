}

func.def inline @ggml_kquant_iq2xs_lane_weights(%grid: buffer, %weight: buffer, %row_base: offset, %block: index, %lane16: index) -> (vector<16xf32>, index, index, index, index) {
  %c4 = index.constant 4 : index
