  %scale_high_byte = view.load %scale_view[%scale_high_index] : view<12xi8> -> i8
  %scale_low_i32 = scalar.extui %scale_low_byte : i8 to i32
  %scale_high_i32 = scalar.extui %scale_high_byte : i8 to i32
  %scale_low_shift = scf.select %uses_high_nibble, %c4_i32, %c0_i32 : i32
  %scale_low_shifted = scalar.shrui %scale_low_i32, %scale_low_shift : i32
  %scale_low = scalar.andi %scale_low_shifted, %c15_i32 : i32
  %scale_group_quartile = index.div %scale_index, %c4 : index
  %scale_high_shift_index = index.mul %scale_group_quartile, %c2 : index
  %scale_high_shift = index.cast %scale_high_shift_index : index to i32
