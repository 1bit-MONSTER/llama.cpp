  %hmask_bit_shift = index.cast %bounded_group : index to i32
  %hmask_bit = scalar.shli %c1_i32, %hmask_bit_shift : i32
  %q_bytes = vector.load %code_view[%code_index] : view<64xi8> -> vector<4xi8>
