  %c28_i32 = scalar.constant 28 : i32
  %c127_i32 = scalar.constant 127 : i32
  %c65535_i32 = scalar.constant 65535 : i32
  %c05_f32 = scalar.constant 0.5 : f32
  %c025_f32 = scalar.constant 0.25 : f32
